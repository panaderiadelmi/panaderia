rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Imágenes de producto ─────────────────────────────────────────────────
    // Lectura pública; subida solo admin
    match /productos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.rol == 'administrador'
        && request.resource.size < 5 * 1024 * 1024   // 5 MB máx
        && request.resource.contentType.matches('image/.*');
    }

    // ── Logo e imágenes de marca ─────────────────────────────────────────────
    match /marca/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.rol == 'administrador'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Facturas en PDF ──────────────────────────────────────────────────────
    // Lectura solo para el cliente propietario y admin; escritura solo CF
    match /facturas/{clienteId}/{facturaId} {
      allow read: if request.auth != null
        && (request.auth.token.rol == 'administrador'
            || request.auth.uid == clienteId);
      allow write: if false; // Solo Cloud Functions
    }

    // ── Albaranes e impresión ────────────────────────────────────────────────
    match /albaranes/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.rol == 'administrador';
      allow write: if false;
    }

  }
}
