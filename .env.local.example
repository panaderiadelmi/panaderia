# ============================================================
# SEÑAS GÓMEZ — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================

# ── Firebase (cliente — valores públicos, van en el frontend) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (servidor — NUNCA exponer al cliente) ──
# Opción A: JSON de la cuenta de servicio en una sola línea
FIREBASE_ADMIN_SDK_JSON=

# Opción B: campos individuales (usar solo si la opción A da problemas)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Stripe ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── App ──
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Email (Resend recomendado) ──
RESEND_API_KEY=

# ── Facturación Verifactu (proveedor a elegir) ──
VERIFACTU_API_KEY=
VERIFACTU_API_URL=
